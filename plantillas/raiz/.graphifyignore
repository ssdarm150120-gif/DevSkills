.env.*
*.env.local
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
*.secret
*.secrets
.netrc
.pgpass
.pypirc
.devskills/

