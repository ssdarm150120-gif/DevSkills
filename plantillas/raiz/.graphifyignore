# Lo que es (codigo/): migraciones generadas y despliegue no describen el diseño
codigo/**/migraciones/
codigo/despliegue/

# Deber ser (documentacion/): solo SRS, DISEÑO, PLAN, CONTEXTO y la evaluación de alternativas.
# Fuera: datos del negocio, transcripciones de sesiones (pueden traer datos pegados), generadores, Word y avance.
documentacion/analisis/
documentacion/sesiones/
documentacion/presentacion/
documentacion/word/
documentacion/avance/
documentacion/ui/
documentacion/*.html
