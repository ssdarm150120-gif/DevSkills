# Entorno (los secretos reales nunca se versionan; solo `.env.ejemplo`, con valores ficticios)
.venv/
.env
.env.*
!.env.ejemplo
*.env.local

# Llaves y archivos de credenciales (nunca se versionan; la llave y el certificado autofirmados de
# desarrollo se GENERAN con despliegue/nginx/generar_certificado.sh y viven en un volumen, fuera de git)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
credentials.*.json
service-account*.json
*.secret
*.secrets
.netrc
.pgpass
.pypirc

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# PostgreSQL embebido: datos de desarrollo (.pgdata) y de pruebas (.pgdata_pruebas)
.pgdata/
.pgdata_pruebas/

# Office (archivos temporales de bloqueo)
~$*

# Datos de análisis con información del negocio (la línea base se mide con datos reales)
documentacion/analisis/datos/

# Generador de la presentación (Node): dependencias locales
# (package-lock.json SI se versiona: fija las versiones y los hashes de lo que se instala con `npm ci`)
documentacion/presentacion/node_modules/
node_modules/

# Residuos de pruebas manuales con curl (pueden contener cookies de sesión)
jar_*
cookies*.txt
cuerpo*.html
