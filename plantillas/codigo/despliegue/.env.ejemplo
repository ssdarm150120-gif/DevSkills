# Variables de entorno del Docker Compose de {{NOMBRE_PROYECTO}} (desarrollo y pruebas).
#
#   cp .env.ejemplo .env     # y reemplaza CADA valor que diga CAMBIAR
#
# Este archivo SI se versiona y solo trae valores FICTICIOS: los que dicen CAMBIAR no sirven a
# proposito. Si lo copias tal cual, la aplicacion se niega a arrancar (`sin_marcador_de_ejemplo` en
# configuracion/entorno.py). El `.env` real NUNCA se versiona (ver .gitignore).
#
# Genera cada secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cada llave debe ser DISTINTA de las demas: si una se filtra, no compromete a las otras.

# --- Secretos de la aplicacion --------------------------------------------------------------------
# Clave de Django: al menos 50 caracteres y 16 distintos; nunca la de desarrollo.
SECRET_KEY=CAMBIAR_clave_secreta_de_django_de_al_menos_50_caracteres_aleatorios
# Llave del HMAC con que se guarda la huella del correo en el registro de intentos.
APP_LLAVE_HUELLA=CAMBIAR_llave_de_la_huella_del_correo_de_al_menos_50_caracteres
# Llave que CIFRA el secreto del segundo factor. Distinta de `SECRET_KEY` y de `APP_LLAVE_HUELLA`.
# Si se pierde o se cambia, quienes tengan un rol con segundo factor tienen que enrolarse de nuevo.
APP_LLAVE_SEGUNDO_FACTOR=CAMBIAR_llave_del_segundo_factor_de_al_menos_50_caracteres

# --- Base de datos (tres roles, DISENO D.6.3) -----------------------------------------------------
# Administrador del contenedor de PostgreSQL: solo lo usa el paso `migrar` para crear los roles.
POSTGRES_ADMIN_PASSWORD=CAMBIAR_clave_del_administrador_de_postgres
# Rol dueno del esquema: solo lo usa `manage.py migrate` en el paso `migrar`.
APP_MIGRACIONES_PASSWORD=CAMBIAR_clave_del_rol_de_migraciones
# Rol de ejecucion de `web` y los workers: solo SELECT, INSERT, UPDATE y DELETE.
APP_WEB_PASSWORD=CAMBIAR_clave_del_rol_de_la_aplicacion

# --- Redis -----------------------------------------------------------------------------------------
REDIS_PASSWORD=CAMBIAR_clave_de_redis

# --- Hosts -----------------------------------------------------------------------------------------
# Hosts que atiende Django, separados por comas. NUNCA `*` ni un comodin de sufijo publico
# (`.com.mx`, `.github.io`): un comodin solo si cuelga de un dominio PROPIO, por ejemplo
# `.empresa.example`. En desarrollo basta `localhost`.
ALLOWED_HOSTS=localhost
# Nombre publico del certificado y de la redireccion HTTP -> HTTPS.
APP_NOMBRE_PUBLICO=localhost
# nginx es el unico que publica puertos, y solo en la interfaz de `APP_ENLACE`. Usa SOLO puertos
# del rango propio del proyecto ({{PUERTO_BASE}} a {{PUERTO_FINAL}}) y nunca los reservados del
# host ({{PUERTOS_RESERVADOS}}).
APP_ENLACE=127.0.0.1
APP_PUERTO_HTTP={{PUERTO_HTTP}}
APP_PUERTO_HTTPS={{PUERTO_HTTPS}}
APP_SUFIJO_PUERTO_HTTPS=:{{PUERTO_HTTPS}}

# --- Transporte ------------------------------------------------------------------------------------
# Siempre hay nginx delante: es quien fija `X-Forwarded-Proto`.
CONFIAR_EN_PROXY_TLS=true
# HSTS corto en `localhost`: el navegador recuerda el dominio y TODOS sus puertos, y uno de un ano
# romperia otros servidores locales. En el servidor real borra estas tres lineas (rigen las de
# produccion: un ano, subdominios y preload).
HSTS_SEGUNDOS=300
HSTS_SUBDOMINIOS=false
HSTS_PRELOAD=false

# --- Limite de peticiones en el ingreso (nginx) ----------------------------------------------------
# POST por IP en `/ingresar` y sus etapas. Holgado: varios usuarios detras de una VPN o NAT
# comparten IP. El control principal es el bloqueo por cuenta (5 intentos). Al rebasarlo: 429.
APP_LIMITE_INGRESO=180r/m
APP_RAFAGA_INGRESO=40

# --- Aplicacion (opcionales) -----------------------------------------------------------------------
# Nombre que muestra la interfaz y que aparece como emisor en la aplicacion de codigos.
APP_NOMBRE_APLICACION={{NOMBRE_PROYECTO}}
# Zona horaria con la que se muestran las fechas (IANA `Area/Ciudad` o `UTC`). Vacia: la de
# `ZONA_PREDETERMINADA` en configuracion/localizacion.py (`UTC`, o la que fijo `devskills init --zona`).
APP_ZONA_HORARIA=
# Idioma de la interfaz (`es`, `en`, `es-mx`, `pt-br`...). Vacio: el de `IDIOMA_PREDETERMINADO` en
# configuracion/localizacion.py (`es`, o el que fijo `devskills init --idioma`).
APP_IDIOMA=

# --- TLS hacia la base y Redis (solo produccion) ---------------------------------------------------
# `true` obliga a `DATABASE_URL` con `?sslmode=verify-full` (o `verify-ca` / `require`) y a
# `REDIS_URL` con `rediss://`; si falta cualquiera, la aplicacion no arranca. En este Compose la base
# y Redis viajan por la red interna sin TLS, por eso queda en `false`. Activalo cuando la base o
# Redis esten fuera del host (servicio administrado). Ver "TLS hacia la base y Redis" en el README.
APP_EXIGIR_TLS_DATOS=false
