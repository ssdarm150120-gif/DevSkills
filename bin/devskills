#!/usr/bin/env bash

# ============================================================================
# DevSkills - CLI
# ============================================================================
# Crea proyectos nuevos con la metodología y el stack fijo de DevSkills,
# revisa los requisitos de la máquina y actualiza la instalación.
# Funciona en macOS, Linux y Windows con Git Bash.
# ============================================================================

set -euo pipefail

VERSION="${DEVSKILLS_VERSION:-1.0.0}"

# Carpeta con la carga útil (plantillas, skills, scripts). En el repositorio es
# la raíz del clon; el instalador reescribe esta línea con la carpeta instalada.
DEVSKILLS_HOME="${DEVSKILLS_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

if [[ -t 1 ]]; then
  ROJO='\033[0;31m'; VERDE='\033[0;32m'; AMARILLO='\033[1;33m'; CIAN='\033[0;36m'; NEGRITA='\033[1m'; NC='\033[0m'
else
  ROJO=''; VERDE=''; AMARILLO=''; CIAN=''; NEGRITA=''; NC=''
fi

ok()    { echo -e "${VERDE}✔${NC} $*"; }
aviso() { echo -e "${AMARILLO}⚠${NC} $*"; }
error() { echo -e "${ROJO}✘${NC} $*" >&2; }

detectar_so() {
  case "$(uname -s)" in
    Darwin*) echo "macos" ;;
    MINGW*|MSYS*|CYGWIN*) echo "windows" ;;
    *) echo "linux" ;;
  esac
}

# Devuelve el comando de un Python 3.12 o vacío si no hay.
buscar_python() {
  local candidato
  for candidato in python3.12 python3 python "py -3.12"; do
    # shellcheck disable=SC2086
    if $candidato -c 'import sys; sys.exit(0 if sys.version_info[:2] == (3, 12) else 1)' >/dev/null 2>&1; then
      echo "$candidato"
      return 0
    fi
  done
  return 1
}

mostrar_ayuda() {
  cat <<EOF
DevSkills ${VERSION} — metodología y stack fijo para sistemas nuevos

Uso:
  devskills init <ruta> [opciones]   Crea un proyecto nuevo con la estructura y el esqueleto
      --nombre "<Nombre>"            Nombre legible del sistema (por defecto, el de la carpeta)
      --slug <slug>                  Prefijo de Docker y project de engram (por defecto, derivado del nombre)
      --puerto-base <N>              Inicio del rango de 50 puertos del host (por defecto 20000)
      --puertos-reservados <lista>   Puertos del host que nunca se usan (por defecto 5432)
      --autor "<Autor>"              Autor de los documentos (por defecto, git config user.name)
      --correo <correo>              user.email local del repo nuevo, antes del primer commit. Sin él se usa el
                                     correo global de git (puede ser corporativo) y se avisa cuál quedó; en un
                                     repo público conviene el noreply de GitHub (<id>+<usuario>@users.noreply.github.com)
      --idioma <código>              Idioma de la interfaz y de Django: es, en, es-mx, pt-br... (por defecto es)
      --zona <zona>                  Zona horaria con que se muestran las fechas: UTC o Area/Ciudad,
                                     por ejemplo America/Bogota (por defecto UTC; se guardan siempre en UTC)
      --sin-git                      No inicializa git ni hace el primer commit
  devskills doctor                   Revisa los requisitos: obligatorios (git, Python 3.12, Claude Code, gitleaks) y
                                     opcionales con lo que pierdes sin ellos (Docker, semgrep, Node, mermaid-cli, gh, Graphify,
                                     engram); dentro de un proyecto, también el merge driver de Graphify
  devskills version                  Muestra la versión
  devskills update [--si]            Muestra los cambios del clon de origen, pide confirmación y reinstala
                                     (--si confirma sin preguntar; sin terminal es obligatorio)
  devskills sync-scripts [ruta] [--si]
                                     Actualiza los scripts .py de documentacion/analisis/ de un proyecto creado antes
                                     con los de la plantilla actual: muestra la lista y el diff --stat, pide
                                     confirmación (--si sin terminal) y copia solo esos scripts. No toca codigo/, ni
                                     documentacion/*.md, ni los JSON de datos; si la plantilla HTML del proyecto
                                     difiere de la de DevSkills, la compara y avisa, pero no la copia
  devskills help                     Muestra esta ayuda

Dentro de Claude Code, el mismo arranque se hace con /devskills:nuevo-proyecto.
EOF
}

slug_de() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null \
    | sed -e 's/[^a-z0-9]\+/-/g' -e 's/^-*//' -e 's/-*$//' -e 's/^[^a-z]*//' || true
}

cmd_init() {
  local ruta="" nombre="" slug="" puerto_base="20000" reservados="5432" autor="" correo="" sin_git="" idioma="es" zona="UTC"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --nombre) nombre="${2:-}"; shift 2 ;;
      --slug) slug="${2:-}"; shift 2 ;;
      --puerto-base) puerto_base="${2:-}"; shift 2 ;;
      --puertos-reservados) reservados="${2:-}"; shift 2 ;;
      --autor) autor="${2:-}"; shift 2 ;;
      --correo) correo="${2:-}"; shift 2 ;;
      --idioma) idioma="${2:-}"; shift 2 ;;
      --zona) zona="${2:-}"; shift 2 ;;
      --sin-git) sin_git="--sin-git"; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) if [[ -z "$ruta" ]]; then ruta="$1"; shift; else error "Argumento de más: $1"; return 2; fi ;;
    esac
  done
  if [[ -z "$ruta" ]]; then
    error "Falta la ruta del proyecto. Uso: devskills init <ruta> [--nombre \"<Nombre>\"]"
    return 2
  fi
  [[ -z "$nombre" ]] && nombre="$(basename "$ruta")"
  [[ -z "$slug" ]] && slug="$(slug_de "$nombre")"
  if [[ -z "$slug" ]]; then
    error "No pude derivar un slug de \"$nombre\"; pásalo con --slug"
    return 2
  fi
  [[ -z "$autor" ]] && autor="$(git config user.name 2>/dev/null || echo "Por definir")"

  local python
  if ! python="$(buscar_python)"; then
    error "Hace falta Python 3.12. Corre 'devskills doctor' para ver cómo instalarlo."
    return 1
  fi
  local script="$DEVSKILLS_HOME/skills/iniciar-proyecto/scripts/crear_proyecto.py"
  if [[ ! -f "$script" ]]; then
    error "No encuentro $script; reinstala DevSkills."
    return 1
  fi
  # El Python de Windows es nativo: Git Bash solo convierte por sí solo las rutas "normales", y una ruta con
  # &, # o ' le llegaría a Python en formato de Unix. cygpath la deja en formato de Windows (C:/...).
  if command -v cygpath >/dev/null 2>&1; then
    script="$(cygpath -m "$script")"
    ruta="$(cygpath -m "$ruta")"
  fi
  local args=(--destino "$ruta" --nombre "$nombre" --slug "$slug" --puerto-base "$puerto_base"
              --puertos-reservados "$reservados" --autor "$autor" --idioma "$idioma" --zona "$zona")
  [[ -n "$correo" ]] && args+=("--correo=$correo")
  [[ -n "$sin_git" ]] && args+=("$sin_git")
  # shellcheck disable=SC2086
  $python "$script" "${args[@]}"
  echo ""
  echo -e "${NEGRITA}Siguientes pasos:${NC}"
  echo "  1. cd \"$ruta\" y abre Claude Code con el plugin DevSkills instalado."
  echo "  2. Pide el descubrimiento: el analista-arquitecto llena documentacion/CONTEXTO.md y el SRS 0.1."
  echo "  3. SRS → DISEÑO → PLAN → Entrega 0 de cimientos → /devskills:ciclo <ID> por historia."
  echo "  4. Opcional, grafo de conocimiento sin LLM: graphify update codigo && graphify update documentacion"
  echo "     (ver \"Grafo de conocimiento (Graphify)\" en documentacion/CONTEXTO.md)."
}

revisar() {
  # revisar <etiqueta> <cómo instalar> <comando...>   (obligatorio: si falta, cuenta como requisito faltante)
  # El comando es una lista de argumentos (o una función); nunca una cadena interpretada como código.
  local etiqueta="$1" como="$2"
  shift 2
  if "$@" >/dev/null 2>&1; then
    ok "$etiqueta"
    return 0
  fi
  aviso "$etiqueta — falta. $como"
  return 1
}

revisar_opcional() {
  # revisar_opcional <etiqueta> <qué se pierde sin él y cómo instalarlo> <comando...>   (solo advertencia)
  local etiqueta="$1" como="$2"
  shift 2
  if "$@" >/dev/null 2>&1; then
    ok "$etiqueta"
    return 0
  fi
  aviso "$etiqueta (opcional) — no está. $como"
  return 1
}

# Versión de semgrep que fija el CI de la plantilla (semgrep==X.Y.Z); 1.178.0 si no se puede leer.
version_semgrep() {
  local version
  version="$(sed -n 's/.*semgrep==\([0-9][0-9.]*\).*/\1/p' "$DEVSKILLS_HOME/plantillas/raiz/.github/workflows/ci.yml" 2>/dev/null | head -n 1)"
  echo "${version:-1.178.0}"
}

hay_semgrep() {
  # shellcheck disable=SC2016  # el $HOME de wsl sh -c debe expandirse dentro de WSL, no aquí
  command -v semgrep || semgrep --version || test -x "$HOME/semgrep/bin/semgrep" \
    || (command -v wsl && wsl sh -c '"$HOME/semgrep/bin/semgrep" --version') || (command -v wsl && wsl semgrep --version) \
    || docker image inspect semgrep/semgrep:1.178.0@sha256:32e459968daabe7ab86968184a29109b9564aa00392401156f9788452b42786b
}

# Cómo instalar semgrep según el sistema. Lo instala la persona: ningún agente instala software.
como_instalar_semgrep() {
  local version
  version="$(version_semgrep)"
  case "$(detectar_so)" in
    windows) echo "En Windows corre dentro de WSL, en un venv (no en el Python de Windows): abre 'wsl' y ahí 'python3 -m venv ~/semgrep && ~/semgrep/bin/pip install semgrep==${version}'; se usa como '~/semgrep/bin/semgrep'. O con Docker (imagen fijada en docs/stack.md)." ;;
    macos) echo "En macOS: 'pipx install semgrep==${version}' (o 'python3 -m venv ~/semgrep && ~/semgrep/bin/pip install semgrep==${version}')." ;;
    *) echo "En Linux: 'python3 -m venv ~/semgrep && ~/semgrep/bin/pip install semgrep==${version}' (o 'pipx install semgrep==${version}')." ;;
  esac
}

hay_mmdc() {
  command -v mmdc || test -e "$HOME/.devskills/doc/node_modules/.bin/mmdc" || test -e "$HOME/.devskills/doc/node_modules/.bin/mmdc.cmd"
}

# Graphify (grafo de conocimiento del proyecto): opcional. Sin él, los agentes exploran con lecturas normales.
hay_graphify() {
  graphify --version
}

# Merge driver local de Graphify para los graph.json versionados (lo deja `devskills init`; un clon nuevo lo repite).
hay_merge_driver_graphify() {
  git config --get merge.graphify.driver
}

hay_engram() {
  claude plugin list 2>/dev/null | grep -qi engram || command -v engram
}

cmd_doctor() {
  local so faltan=0 opcionales=0
  so="$(detectar_so)"
  echo -e "${CIAN}${NEGRITA}DevSkills doctor${NC} (${so})"
  echo -e "${NEGRITA}Obligatorios${NC}"
  revisar "git" "Instálalo: https://git-scm.com/downloads" git --version || faltan=$((faltan + 1))
  if python="$(buscar_python)"; then
    ok "Python 3.12 ($python)"
  else
    aviso "Python 3.12 — falta. Windows: 'winget install Python.Python.3.12'; macOS: 'brew install python@3.12'; Linux: el paquete python3.12 de tu distribución."
    faltan=$((faltan + 1))
  fi
  revisar "Claude Code" "Instálalo: https://code.claude.com" claude --version || faltan=$((faltan + 1))
  # gitleaks es obligatorio para cerrar cualquier commit, pero basta UNA vía: el binario nativo o Docker.
  if command -v gitleaks >/dev/null 2>&1; then
    ok "gitleaks (nativo)"
  elif docker image inspect zricethezav/gitleaks:v8.21.2@sha256:0e99e8821643ea5b235718642b93bb32486af9c8162c8b8731f7cbdc951a7f46 >/dev/null 2>&1; then
    ok "gitleaks (por Docker)"
  else
    aviso "gitleaks — falta. Sin él no se puede cerrar un commit. Instálalo: Windows 'winget install Gitleaks.Gitleaks'; macOS 'brew install gitleaks'; Linux la release de https://github.com/gitleaks/gitleaks/releases (o, si usas Docker, 'docker pull zricethezav/gitleaks:v8.21.2@sha256:0e99e8821643ea5b235718642b93bb32486af9c8162c8b8731f7cbdc951a7f46')."
    faltan=$((faltan + 1))
  fi
  echo -e "${NEGRITA}Opcionales (no bloquean; dicen qué pierdes)${NC}"
  # Docker NO es requisito: se desarrolla y se prueba con PostgreSQL embebido y Celery local.
  revisar_opcional "Docker (cliente)" "Sin él no puedes levantar el stack con Compose ni construir la imagen en tu máquina; se sigue desarrollando y probando sin Docker. Para desplegar: Docker Desktop (Windows/macOS) o Docker Engine (Linux)." docker --version || opcionales=$((opcionales + 1))
  revisar_opcional "Docker (servicio en marcha)" "Sin el servicio, se omiten solas las pruebas de Compose y del certificado (corren en el CI). Arranca Docker Desktop o el servicio solo si necesitas el stack completo." docker info || opcionales=$((opcionales + 1))
  revisar_opcional "semgrep (análisis estático local)" "Sin él no corres semgrep en tu máquina; el CI de GitHub lo corre siempre y es obligatorio ahí. $(como_instalar_semgrep) Instálalo tú: los agentes del equipo no instalan software y se detienen si falta." hay_semgrep || opcionales=$((opcionales + 1))
  revisar_opcional "Node.js (presentación y mermaid-cli)" "Sin él no generas la presentación ni los diagramas de los Word. Instala Node LTS: https://nodejs.org (o 'winget install OpenJS.NodeJS.LTS')." node --version || opcionales=$((opcionales + 1))
  revisar_opcional "mermaid-cli (diagramas de los Word)" \
    "Sin él los diagramas de los Word quedan como bloque de código. Instálalo en una carpeta local: 'npm install --save-exact --prefix ~/.devskills/doc @mermaid-js/mermaid-cli@12.0.0' y úsalo con 'md_a_word.py --mermaid ~/.devskills/doc' (ver docs/generadores.md)." hay_mmdc || opcionales=$((opcionales + 1))
  revisar_opcional "GitHub CLI (gh)" "Sin él no revisas el CI desde la terminal ni creas el remoto con un comando. Windows 'winget install GitHub.cli'; macOS 'brew install gh'." gh --version || opcionales=$((opcionales + 1))
  revisar_opcional "Graphify (grafo de conocimiento)" \
    "Sin él los agentes exploran el código con lecturas normales (más tokens) y el cierre del sprint omite la verificación de deriva entre el deber ser y el código; el método sigue funcionando igual. Instálalo tú: 'uv tool install graphifyy' (o 'pipx install graphifyy'; el paquete lleva doble y). Los agentes del equipo no instalan software. Ver docs/graphify.md." \
    hay_graphify || opcionales=$((opcionales + 1))
  if [[ -f documentacion/CONTEXTO.md ]] && git rev-parse --git-dir >/dev/null 2>&1; then
    revisar_opcional "Merge driver de Graphify en este proyecto" \
      "Sin él, dos ramas que regeneraron graph.json chocan en el merge. En este clon: git config merge.graphify.name 'graphify graph.json union merge' && git config merge.graphify.driver 'graphify merge-driver %O %A %B'" \
      hay_merge_driver_graphify || opcionales=$((opcionales + 1))
  fi
  revisar_opcional "Plugin engram (memoria persistente)" \
    "Sin él no hay memoria entre sesiones (el ciclo funciona, pero no se guarda el avance). Instálalo como plugin de Claude Code (ver README, sección Requisitos)." hay_engram || opcionales=$((opcionales + 1))
  echo ""
  if [[ $faltan -eq 0 ]]; then
    ok "Todo lo obligatorio está listo."
  else
    aviso "Faltan $faltan requisito(s) obligatorio(s)."
  fi
  if [[ $opcionales -gt 0 ]]; then
    aviso "$opcionales opcional(es) sin instalar: no bloquean el trabajo (arriba dice qué pierdes en cada caso)."
  fi
  return 0
}

cmd_update() {
  local si=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --si|-y) si=true; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      *) error "Opción desconocida: $1"; return 2 ;;
    esac
  done
  local origen_archivo="$DEVSKILLS_HOME/.origen"
  if [[ ! -f "$origen_archivo" ]]; then
    error "No sé de qué clon se instaló DevSkills ($origen_archivo no existe). Actualiza a mano: git pull && bash install.sh"
    return 1
  fi
  local origen
  origen="$(cat "$origen_archivo")"
  if [[ ! -d "$origen/.git" ]]; then
    error "El origen $origen no es un clon de git. Actualiza a mano."
    return 1
  fi
  echo "Origen: $origen ($(git -C "$origen" remote get-url origin 2>/dev/null || echo "sin remoto"))"
  if ! git -C "$origen" fetch --quiet; then
    error "No pude consultar el remoto; no cambié nada."
    return 1
  fi
  local remota
  if ! remota="$(git -C "$origen" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    error "La rama actual del clon no tiene una rama remota asociada; actualiza a mano."
    return 1
  fi
  local nuevos
  nuevos="$(git -C "$origen" rev-list --count "HEAD..$remota")"
  if [[ "$nuevos" == "0" ]]; then
    ok "Ya tienes la última versión; no cambié nada."
    return 0
  fi
  # Se muestra lo que va a cambiar ANTES de traerlo: al actualizar se ejecuta el install.sh del código nuevo.
  echo ""
  echo -e "${NEGRITA}Cambios que traería ($nuevos commits desde $remota):${NC}"
  git -C "$origen" log --oneline "HEAD..$remota"
  echo ""
  git -C "$origen" diff --stat "HEAD" "$remota"
  echo ""
  aviso "Actualizar ejecuta el install.sh del código nuevo. Revísalo antes si no confías en el remoto: git -C \"$origen\" diff HEAD $remota -- install.sh install.ps1 bin/devskills"
  if [[ "$si" != true ]]; then
    if [[ -t 0 ]]; then
      local respuesta
      read -r -p "¿Aplicar estos cambios y reinstalar? (s/N): " respuesta
      if [[ "$respuesta" != "s" && "$respuesta" != "S" ]]; then
        echo "Cancelado; no cambié nada."
        return 0
      fi
    else
      error "Sin terminal no se aplica nada. Revisa los cambios y repite con --si: devskills update --si"
      return 1
    fi
  fi
  if ! git -C "$origen" merge --ff-only --quiet "$remota"; then
    error "No se pudo avanzar el clon sin conflictos (¿cambios locales?). Resuélvelo a mano en $origen."
    return 1
  fi
  bash "$origen/install.sh" --si
}

# Valor de un marcador de plantilla leído de documentacion/CONTEXTO.md del proyecto (vacío si no se puede).
valor_de_marcador() {
  local contexto="$1" marcador="$2" valor=""
  # shellcheck disable=SC2016  # los acentos graves de las expresiones de sed son literales de Markdown
  case "$marcador" in
    NOMBRE_PROYECTO) valor="$(sed -n '1s/^# Contexto del proyecto: *//p' "$contexto" | tr -d '\r')" ;;
    SLUG | SLUG_GUION_BAJO)
      valor="$(sed -n 's/^| Slug (carpetas, Docker, engram) | `\(.*\)` |.*$/\1/p' "$contexto" | head -n 1 | tr -d '\r')"
      [[ "$marcador" == "SLUG_GUION_BAJO" ]] && valor="${valor//-/_}"
      ;;
    PUERTO_BASE) valor="$(sed -n 's/^| Rango de puertos del host | `\([0-9][0-9]*\)` a.*$/\1/p' "$contexto" | head -n 1 | tr -d '\r')" ;;
  esac
  echo "$valor"
}

# Escribe en $3 la plantilla $1 con los marcadores {{...}} sustituidos con los datos del proyecto ($2 = CONTEXTO.md).
# Si algún marcador no se puede resolver, imprime cuál y devuelve 1.
resolver_plantilla() {
  local origen="$1" contexto="$2" salida="$3" texto marcador nombre valor
  shopt -u patsub_replacement 2>/dev/null || true # bash 5.2: "&" en el reemplazo no debe expandirse
  texto="$(cat "$origen"; printf x)"
  texto="${texto%x}"
  while IFS= read -r marcador; do
    [[ -z "$marcador" ]] && continue
    nombre="${marcador#'{{'}"
    nombre="${nombre%'}}'}"
    valor="$(valor_de_marcador "$contexto" "$nombre")"
    if [[ -z "$valor" ]]; then
      echo "$marcador"
      return 1
    fi
    texto="${texto//"$marcador"/$valor}"
  done < <(grep -oE '\{\{[A-Z_]+\}\}' "$origen" | sort -u || true)
  printf '%s' "$texto" >"$salida"
}

cmd_sync_scripts() {
  local si=false ruta=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --si|-y) si=true; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) if [[ -z "$ruta" ]]; then ruta="$1"; shift; else error "Argumento de más: $1"; return 2; fi ;;
    esac
  done
  [[ -z "$ruta" ]] && ruta="."
  local analisis="$ruta/documentacion/analisis" contexto="$ruta/documentacion/CONTEXTO.md"
  if [[ ! -f "$contexto" || ! -d "$analisis" ]]; then
    error "$ruta no es un proyecto DevSkills (falta documentacion/CONTEXTO.md o documentacion/analisis/). No cambié nada."
    return 1
  fi
  local origen="$DEVSKILLS_HOME/plantillas/analisis"
  if [[ ! -d "$origen" ]]; then
    error "No encuentro las plantillas en $origen; reinstala DevSkills."
    return 1
  fi

  local tmp
  tmp="$(mktemp -d)"
  local nuevos="" cambiados="" omitidos="" archivo nombre sin_resolver
  for archivo in "$origen"/*.py; do
    [[ -f "$archivo" ]] || continue
    nombre="$(basename "$archivo")"
    if grep -qE '\{\{[A-Z_]+\}\}' "$archivo"; then
      if ! sin_resolver="$(resolver_plantilla "$archivo" "$contexto" "$tmp/$nombre")"; then
        omitidos="${omitidos}${nombre} (marcador ${sin_resolver} que no se puede resolver desde CONTEXTO.md)"$'\n'
        continue
      fi
    else
      cp "$archivo" "$tmp/$nombre"
    fi
    if [[ ! -f "$analisis/$nombre" ]]; then
      nuevos="${nuevos}${nombre}"$'\n'
    elif ! cmp -s "$tmp/$nombre" "$analisis/$nombre"; then
      cambiados="${cambiados}${nombre}"$'\n'
    fi
  done

  local html="plan_sprints_plantilla.html"
  if [[ -f "$analisis/$html" ]] && ! cmp -s "$origen/$html" "$analisis/$html"; then
    aviso "La plantilla HTML del tablero ($html) difiere de la de DevSkills: no la toco (puede ser una personalización tuya). Compárala y decide:"
    echo "  git diff --no-index \"$analisis/$html\" \"$origen/$html\""
  elif [[ ! -f "$analisis/$html" ]]; then
    aviso "El proyecto no tiene $html; cópiala a mano de $origen si quieres el tablero."
  fi
  if [[ -n "$omitidos" ]]; then
    aviso "Scripts omitidos (compáralos a mano):"
    printf '  %s' "$omitidos"
  fi

  if [[ -z "$nuevos$cambiados" ]]; then
    ok "Los scripts de documentacion/analisis ya están al día; no cambié nada."
    rm -rf "$tmp"
    return 0
  fi

  echo -e "${NEGRITA}Scripts de documentacion/analisis que cambiarían:${NC}"
  while IFS= read -r nombre; do
    [[ -z "$nombre" ]] && continue
    echo "  nuevo     $nombre"
  done <<<"$nuevos"
  while IFS= read -r nombre; do
    [[ -z "$nombre" ]] && continue
    echo "  cambiado  $nombre"
  done <<<"$cambiados"
  echo ""
  while IFS= read -r nombre; do
    [[ -z "$nombre" ]] && continue
    git diff --no-index --stat -- "$analisis/$nombre" "$tmp/$nombre" || true
  done <<<"$cambiados"
  echo ""
  aviso "Solo se copian estos scripts: no se toca codigo/, ni documentacion/*.md, ni los JSON de datos."

  if [[ "$si" != true ]]; then
    if [[ -t 0 ]]; then
      local respuesta
      read -r -p "¿Copiar estos scripts al proyecto? (s/N): " respuesta
      if [[ "$respuesta" != "s" && "$respuesta" != "S" ]]; then
        echo "Cancelado; no cambié nada."
        rm -rf "$tmp"
        return 0
      fi
    else
      error "Sin terminal no se copia nada. Revisa los cambios y repite con --si: devskills sync-scripts --si"
      rm -rf "$tmp"
      return 1
    fi
  fi
  while IFS= read -r nombre; do
    [[ -z "$nombre" ]] && continue
    cp "$tmp/$nombre" "$analisis/$nombre"
    ok "Copiado $nombre"
  done <<<"$nuevos$cambiados"
  rm -rf "$tmp"
  echo "Revisa el resultado con 'git diff' y haz el commit tú o pídeselo al orquestador."
}

main() {
  local comando="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$comando" in
    init) cmd_init "$@" ;;
    doctor) cmd_doctor "$@" ;;
    version|--version|-v) echo "devskills $VERSION" ;;
    update) cmd_update "$@" ;;
    sync-scripts) cmd_sync_scripts "$@" ;;
    help|--help|-h) mostrar_ayuda ;;
    *) error "Comando desconocido: $comando"; mostrar_ayuda; return 2 ;;
  esac
}

main "$@"
