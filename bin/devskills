#!/usr/bin/env bash

# ============================================================================
# DevSkills - CLI
# ============================================================================
# Crea proyectos nuevos con la metodología y el stack fijo de DevSkills,
# revisa los requisitos de la máquina y actualiza la instalación.
# Funciona en macOS, Linux y Windows con Git Bash.
# ============================================================================

set -euo pipefail

VERSION="${DEVSKILLS_VERSION:-1.0.0}"

# Carpeta con la carga útil (plantillas, skills, scripts). En el repositorio es
# la raíz del clon; el instalador reescribe esta línea con la carpeta instalada.
DEVSKILLS_HOME="${DEVSKILLS_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

if [[ -t 1 ]]; then
  ROJO='\033[0;31m'; VERDE='\033[0;32m'; AMARILLO='\033[1;33m'; CIAN='\033[0;36m'; NEGRITA='\033[1m'; NC='\033[0m'
else
  ROJO=''; VERDE=''; AMARILLO=''; CIAN=''; NEGRITA=''; NC=''
fi

ok()    { echo -e "${VERDE}✔${NC} $*"; }
aviso() { echo -e "${AMARILLO}⚠${NC} $*"; }
error() { echo -e "${ROJO}✘${NC} $*" >&2; }

detectar_so() {
  case "$(uname -s)" in
    Darwin*) echo "macos" ;;
    MINGW*|MSYS*|CYGWIN*) echo "windows" ;;
    *) echo "linux" ;;
  esac
}

# Devuelve el comando de un Python 3.12 o vacío si no hay.
buscar_python() {
  local candidato
  for candidato in python3.12 python3 python "py -3.12"; do
    # shellcheck disable=SC2086
    if $candidato -c 'import sys; sys.exit(0 if sys.version_info[:2] == (3, 12) else 1)' >/dev/null 2>&1; then
      echo "$candidato"
      return 0
    fi
  done
  return 1
}

mostrar_ayuda() {
  cat <<EOF
DevSkills ${VERSION} — metodología y stack fijo para sistemas nuevos

Uso:
  devskills init <ruta> [opciones]   Crea un proyecto nuevo con la estructura y el esqueleto
      --nombre "<Nombre>"            Nombre legible del sistema (por defecto, el de la carpeta)
      --slug <slug>                  Prefijo de Docker y project de engram (por defecto, derivado del nombre)
      --puerto-base <N>              Inicio del rango de 50 puertos del host (por defecto 20000)
      --puertos-reservados <lista>   Puertos del host que nunca se usan (por defecto 5432)
      --autor "<Autor>"              Autor de los documentos (por defecto, git config user.name)
      --correo <correo>              user.email local del repo nuevo, antes del primer commit. Sin él se usa el
                                     correo global de git (puede ser corporativo) y se avisa cuál quedó; en un
                                     repo público conviene el noreply de GitHub (<id>+<usuario>@users.noreply.github.com)
      --idioma <código>              Idioma de la interfaz y de Django: es, en, es-mx, pt-br... (por defecto es)
      --zona <zona>                  Zona horaria con que se muestran las fechas: UTC o Area/Ciudad,
                                     por ejemplo America/Bogota (por defecto UTC; se guardan siempre en UTC)
      --sin-git                      No inicializa git ni hace el primer commit
  devskills doctor                   Revisa los requisitos: obligatorios (git, Python 3.12, Claude Code, gitleaks) y
                                     opcionales con lo que pierdes sin ellos (Docker, semgrep, Node, mermaid-cli, gh, Graphify,
                                     engram); dentro de un proyecto, también el merge driver de Graphify
  devskills version                  Muestra la versión
  devskills update [--si]            Muestra los cambios del clon de origen, pide confirmación y reinstala
                                     (--si confirma sin preguntar; sin terminal es obligatorio)
  devskills sync-scripts [ruta] [--si]
                                     Actualiza los scripts .py de documentacion/analisis/ de un proyecto creado antes
                                     con los de la plantilla actual: muestra la lista y el diff --stat, pide
                                     confirmación (--si sin terminal) y copia solo esos scripts. No toca codigo/, ni
                                     documentacion/*.md, ni los JSON de datos; si la plantilla HTML del proyecto
                                     difiere de la de DevSkills, la compara y avisa, pero no la copia
  devskills enrutamiento [estado|activar|desactivar|evaluar] [ruta] [--forzar]
                                     Enrutamiento de modelo y esfuerzo de los subagentes (archivo local
                                     .devskills/enrutamiento.json, ignorado por git; ver docs/enrutamiento.md):
                                     estado (por omisión) lo muestra; activar crea el archivo con la tabla por
                                     omisión o reactiva el existente sin tocar su tabla (--forzar la reescribe);
                                     desactivar lo apaga sin borrar la tabla; evaluar revisa si el proyecto encaja
                                     (pruebas y su comando, CI, tipos y lint, Gherkin) y da un veredicto
  devskills panel [iniciar|apagar|estado] [--puerto N] [--no-abrir] [--simular]
                                     Panel de control local (motor gráfico; solo biblioteca estándar de Python, escucha
                                     en 127.0.0.1, puerto 18950 por omisión). iniciar es la acción por omisión
  devskills servicios <levantar|apagar|listar> [objetivo] [--simular]
                                     Lanzador multiplataforma de los servicios del registro de proyectos (lista blanca
                                     de tipos: dotnet, npm, django-devskills, python-modulo, docker-compose);
                                     --simular muestra qué haría sin ejecutar nada
  devskills orquestador [instalar|iniciar|apagar|estado]
                                     Orquestador local OPCIONAL (API para mandar instrucciones a las sesiones de Claude
                                     Code). instalar crea un venv propio con claude-agent-sdk; sin instalarlo, el
                                     panel y los servicios funcionan igual
  devskills motor iniciar            Crea el registro de proyectos desde la plantilla si no existe y apunta a la
                                     detección automática del panel
  devskills motor migrar --desde <carpeta> [--forzar]
                                     Copia los DATOS de una instalación previa (proyectos.json, preferencias, estado
                                     del panel, historial y propuestas del orquestador) al directorio de datos, sin
                                     sobrescribir lo existente (salvo --forzar) y sin tocar el origen
                                     El directorio de datos es DEVSKILLS_DATOS o ~/.devskills (ver docs/motor.md)
  devskills help                     Muestra esta ayuda

Dentro de Claude Code, el mismo arranque se hace con /devskills:nuevo-proyecto.
EOF
}

slug_de() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null \
    | sed -e 's/[^a-z0-9]\+/-/g' -e 's/^-*//' -e 's/-*$//' -e 's/^[^a-z]*//' || true
}

cmd_init() {
  local ruta="" nombre="" slug="" puerto_base="20000" reservados="5432" autor="" correo="" sin_git="" idioma="es" zona="UTC"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --nombre) nombre="${2:-}"; shift 2 ;;
      --slug) slug="${2:-}"; shift 2 ;;
      --puerto-base) puerto_base="${2:-}"; shift 2 ;;
      --puertos-reservados) reservados="${2:-}"; shift 2 ;;
      --autor) autor="${2:-}"; shift 2 ;;
      --correo) correo="${2:-}"; shift 2 ;;
      --idioma) idioma="${2:-}"; shift 2 ;;
      --zona) zona="${2:-}"; shift 2 ;;
      --sin-git) sin_git="--sin-git"; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) if [[ -z "$ruta" ]]; then ruta="$1"; shift; else error "Argumento de más: $1"; return 2; fi ;;
    esac
  done
  if [[ -z "$ruta" ]]; then
    error "Falta la ruta del proyecto. Uso: devskills init <ruta> [--nombre \"<Nombre>\"]"
    return 2
  fi
  [[ -z "$nombre" ]] && nombre="$(basename "$ruta")"
  [[ -z "$slug" ]] && slug="$(slug_de "$nombre")"
  if [[ -z "$slug" ]]; then
    error "No pude derivar un slug de \"$nombre\"; pásalo con --slug"
    return 2
  fi
  [[ -z "$autor" ]] && autor="$(git config user.name 2>/dev/null || echo "Por definir")"

  local python
  if ! python="$(buscar_python)"; then
    error "Hace falta Python 3.12. Corre 'devskills doctor' para ver cómo instalarlo."
    return 1
  fi
  local script="$DEVSKILLS_HOME/skills/iniciar-proyecto/scripts/crear_proyecto.py"
  if [[ ! -f "$script" ]]; then
    error "No encuentro $script; reinstala DevSkills."
    return 1
  fi
  # El Python de Windows es nativo: Git Bash solo convierte por sí solo las rutas "normales", y una ruta con
  # &, # o ' le llegaría a Python en formato de Unix. cygpath la deja en formato de Windows (C:/...).
  if command -v cygpath >/dev/null 2>&1; then
    script="$(cygpath -m "$script")"
    ruta="$(cygpath -m "$ruta")"
  fi
  local args=(--destino "$ruta" --nombre "$nombre" --slug "$slug" --puerto-base "$puerto_base"
              --puertos-reservados "$reservados" --autor "$autor" --idioma "$idioma" --zona "$zona")
  [[ -n "$correo" ]] && args+=("--correo=$correo")
  [[ -n "$sin_git" ]] && args+=("$sin_git")
  # shellcheck disable=SC2086
  $python "$script" "${args[@]}"
  echo ""
  echo -e "${NEGRITA}Siguientes pasos:${NC}"
  echo "  1. cd \"$ruta\" y abre Claude Code con el plugin DevSkills instalado."
  echo "  2. Pide el descubrimiento: el analista-arquitecto llena documentacion/CONTEXTO.md y el SRS 0.1."
  echo "  3. SRS → DISEÑO → PLAN → Entrega 0 de cimientos → /devskills:ciclo <ID> por historia."
  echo "  4. Opcional, grafo de conocimiento sin LLM: graphify update codigo && graphify update documentacion"
  echo "     (ver \"Grafo de conocimiento (Graphify)\" en documentacion/CONTEXTO.md)."
}

revisar() {
  # revisar <etiqueta> <cómo instalar> <comando...>   (obligatorio: si falta, cuenta como requisito faltante)
  # El comando es una lista de argumentos (o una función); nunca una cadena interpretada como código.
  local etiqueta="$1" como="$2"
  shift 2
  if "$@" >/dev/null 2>&1; then
    ok "$etiqueta"
    return 0
  fi
  aviso "$etiqueta — falta. $como"
  return 1
}

revisar_opcional() {
  # revisar_opcional <etiqueta> <qué se pierde sin él y cómo instalarlo> <comando...>   (solo advertencia)
  local etiqueta="$1" como="$2"
  shift 2
  if "$@" >/dev/null 2>&1; then
    ok "$etiqueta"
    return 0
  fi
  aviso "$etiqueta (opcional) — no está. $como"
  return 1
}

# Versión de semgrep que fija el CI de la plantilla (semgrep==X.Y.Z); 1.178.0 si no se puede leer.
version_semgrep() {
  local version
  version="$(sed -n 's/.*semgrep==\([0-9][0-9.]*\).*/\1/p' "$DEVSKILLS_HOME/plantillas/raiz/.github/workflows/ci.yml" 2>/dev/null | head -n 1)"
  echo "${version:-1.178.0}"
}

hay_semgrep() {
  # shellcheck disable=SC2016  # el $HOME de wsl sh -c debe expandirse dentro de WSL, no aquí
  command -v semgrep || semgrep --version || test -x "$HOME/semgrep/bin/semgrep" \
    || (command -v wsl && wsl sh -c '"$HOME/semgrep/bin/semgrep" --version') || (command -v wsl && wsl semgrep --version) \
    || docker image inspect semgrep/semgrep:1.178.0@sha256:32e459968daabe7ab86968184a29109b9564aa00392401156f9788452b42786b
}

# Cómo instalar semgrep según el sistema. Lo instala la persona: ningún agente instala software.
como_instalar_semgrep() {
  local version
  version="$(version_semgrep)"
  case "$(detectar_so)" in
    windows) echo "En Windows corre dentro de WSL, en un venv (no en el Python de Windows): abre 'wsl' y ahí 'python3 -m venv ~/semgrep && ~/semgrep/bin/pip install semgrep==${version}'; se usa como '~/semgrep/bin/semgrep'. O con Docker (imagen fijada en docs/stack.md)." ;;
    macos) echo "En macOS: 'pipx install semgrep==${version}' (o 'python3 -m venv ~/semgrep && ~/semgrep/bin/pip install semgrep==${version}')." ;;
    *) echo "En Linux: 'python3 -m venv ~/semgrep && ~/semgrep/bin/pip install semgrep==${version}' (o 'pipx install semgrep==${version}')." ;;
  esac
}

hay_mmdc() {
  command -v mmdc || test -e "$HOME/.devskills/doc/node_modules/.bin/mmdc" || test -e "$HOME/.devskills/doc/node_modules/.bin/mmdc.cmd"
}

# Graphify (grafo de conocimiento del proyecto): opcional. Sin él, los agentes exploran con lecturas normales.
hay_graphify() {
  graphify --version
}

# Merge driver local de Graphify para los graph.json versionados (lo deja `devskills init`; un clon nuevo lo repite).
hay_merge_driver_graphify() {
  git config --get merge.graphify.driver
}

hay_motor() {
  test -f "$DEVSKILLS_HOME/motor/panel/panel.py" && test -f "$DEVSKILLS_HOME/motor/servicios/servicios.py"
}

hay_registro_motor() {
  test -f "$(datos_motor)/proyectos.json"
}

hay_orquestador() {
  python_orquestador "$(datos_motor)"
}

hay_engram() {
  claude plugin list 2>/dev/null | grep -qi engram || command -v engram
}

cmd_doctor() {
  local so faltan=0 opcionales=0
  so="$(detectar_so)"
  echo -e "${CIAN}${NEGRITA}DevSkills doctor${NC} (${so})"
  echo -e "${NEGRITA}Obligatorios${NC}"
  revisar "git" "Instálalo: https://git-scm.com/downloads" git --version || faltan=$((faltan + 1))
  if python="$(buscar_python)"; then
    ok "Python 3.12 ($python)"
  else
    aviso "Python 3.12 — falta. Windows: 'winget install Python.Python.3.12'; macOS: 'brew install python@3.12'; Linux: el paquete python3.12 de tu distribución."
    faltan=$((faltan + 1))
  fi
  revisar "Claude Code" "Instálalo: https://code.claude.com" claude --version || faltan=$((faltan + 1))
  # gitleaks es obligatorio para cerrar cualquier commit, pero basta UNA vía: el binario nativo o Docker.
  if command -v gitleaks >/dev/null 2>&1; then
    ok "gitleaks (nativo)"
  elif docker image inspect zricethezav/gitleaks:v8.21.2@sha256:0e99e8821643ea5b235718642b93bb32486af9c8162c8b8731f7cbdc951a7f46 >/dev/null 2>&1; then
    ok "gitleaks (por Docker)"
  else
    aviso "gitleaks — falta. Sin él no se puede cerrar un commit. Instálalo: Windows 'winget install Gitleaks.Gitleaks'; macOS 'brew install gitleaks'; Linux la release de https://github.com/gitleaks/gitleaks/releases (o, si usas Docker, 'docker pull zricethezav/gitleaks:v8.21.2@sha256:0e99e8821643ea5b235718642b93bb32486af9c8162c8b8731f7cbdc951a7f46')."
    faltan=$((faltan + 1))
  fi
  echo -e "${NEGRITA}Opcionales (no bloquean; dicen qué pierdes)${NC}"
  # Docker NO es requisito: se desarrolla y se prueba con PostgreSQL embebido y Celery local.
  revisar_opcional "Docker (cliente)" "Sin él no puedes levantar el stack con Compose ni construir la imagen en tu máquina; se sigue desarrollando y probando sin Docker. Para desplegar: Docker Desktop (Windows/macOS) o Docker Engine (Linux)." docker --version || opcionales=$((opcionales + 1))
  revisar_opcional "Docker (servicio en marcha)" "Sin el servicio, se omiten solas las pruebas de Compose y del certificado (corren en el CI). Arranca Docker Desktop o el servicio solo si necesitas el stack completo." docker info || opcionales=$((opcionales + 1))
  revisar_opcional "semgrep (análisis estático local)" "Sin él no corres semgrep en tu máquina; el CI de GitHub lo corre siempre y es obligatorio ahí. $(como_instalar_semgrep) Instálalo tú: los agentes del equipo no instalan software y se detienen si falta." hay_semgrep || opcionales=$((opcionales + 1))
  revisar_opcional "Node.js (presentación y mermaid-cli)" "Sin él no generas la presentación ni los diagramas de los Word. Instala Node LTS: https://nodejs.org (o 'winget install OpenJS.NodeJS.LTS')." node --version || opcionales=$((opcionales + 1))
  revisar_opcional "mermaid-cli (diagramas de los Word)" \
    "Sin él los diagramas de los Word quedan como bloque de código. Instálalo en una carpeta local: 'npm install --save-exact --prefix ~/.devskills/doc @mermaid-js/mermaid-cli@12.0.0' y úsalo con 'md_a_word.py --mermaid ~/.devskills/doc' (ver docs/generadores.md)." hay_mmdc || opcionales=$((opcionales + 1))
  revisar_opcional "GitHub CLI (gh)" "Sin él no revisas el CI desde la terminal ni creas el remoto con un comando. Windows 'winget install GitHub.cli'; macOS 'brew install gh'." gh --version || opcionales=$((opcionales + 1))
  revisar_opcional "Graphify (grafo de conocimiento)" \
    "Sin él los agentes exploran el código con lecturas normales (más tokens) y el cierre del sprint omite la verificación de deriva entre el deber ser y el código; el método sigue funcionando igual. Instálalo tú: 'uv tool install graphifyy' (o 'pipx install graphifyy'; el paquete lleva doble y). Los agentes del equipo no instalan software. Ver docs/graphify.md." \
    hay_graphify || opcionales=$((opcionales + 1))
  if [[ -f documentacion/CONTEXTO.md ]] && git rev-parse --git-dir >/dev/null 2>&1; then
    revisar_opcional "Merge driver de Graphify en este proyecto" \
      "Sin él, dos ramas que regeneraron graph.json chocan en el merge. En este clon: git config merge.graphify.name 'graphify graph.json union merge' && git config merge.graphify.driver 'graphify merge-driver %O %A %B'" \
      hay_merge_driver_graphify || opcionales=$((opcionales + 1))
  fi
  if [[ -f documentacion/CONTEXTO.md ]]; then
    estado_enrutamiento "."
  fi
  revisar_opcional "Motor gráfico (panel y lanzador de servicios)" \
    "Sin él no tienes el panel local ni 'devskills servicios'. Viene en la carpeta motor/ de DevSkills: reinstala o actualiza (devskills update)." hay_motor || opcionales=$((opcionales + 1))
  if hay_motor; then
    revisar_opcional "Registro de proyectos del motor ($(datos_motor)/proyectos.json)" \
      "Sin él el panel no muestra proyectos. Créalo con 'devskills motor iniciar' o migra el de una instalación previa con 'devskills motor migrar --desde <carpeta>'." hay_registro_motor || opcionales=$((opcionales + 1))
    revisar_opcional "Orquestador del motor (venv propio)" \
      "Es opcional: sin él el panel y los servicios funcionan igual; solo pierdes mandar instrucciones a las sesiones de Claude Code desde el panel. Instálalo con 'devskills orquestador instalar'." hay_orquestador || opcionales=$((opcionales + 1))
  fi
  revisar_opcional "Plugin engram (memoria persistente)" \
    "Sin él no hay memoria entre sesiones (el ciclo funciona, pero no se guarda el avance). Instálalo como plugin de Claude Code (ver README, sección Requisitos)." hay_engram || opcionales=$((opcionales + 1))
  echo ""
  if [[ $faltan -eq 0 ]]; then
    ok "Todo lo obligatorio está listo."
  else
    aviso "Faltan $faltan requisito(s) obligatorio(s)."
  fi
  if [[ $opcionales -gt 0 ]]; then
    aviso "$opcionales opcional(es) sin instalar: no bloquean el trabajo (arriba dice qué pierdes en cada caso)."
  fi
  return 0
}

cmd_update() {
  local si=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --si|-y) si=true; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      *) error "Opción desconocida: $1"; return 2 ;;
    esac
  done
  local origen_archivo="$DEVSKILLS_HOME/.origen"
  if [[ ! -f "$origen_archivo" ]]; then
    error "No sé de qué clon se instaló DevSkills ($origen_archivo no existe). Actualiza a mano: git pull && bash install.sh"
    return 1
  fi
  local origen
  origen="$(cat "$origen_archivo")"
  if [[ ! -d "$origen/.git" ]]; then
    error "El origen $origen no es un clon de git. Actualiza a mano."
    return 1
  fi
  echo "Origen: $origen ($(git -C "$origen" remote get-url origin 2>/dev/null || echo "sin remoto"))"
  if ! git -C "$origen" fetch --quiet; then
    error "No pude consultar el remoto; no cambié nada."
    return 1
  fi
  local remota
  if ! remota="$(git -C "$origen" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    error "La rama actual del clon no tiene una rama remota asociada; actualiza a mano."
    return 1
  fi
  local nuevos
  nuevos="$(git -C "$origen" rev-list --count "HEAD..$remota")"
  if [[ "$nuevos" == "0" ]]; then
    ok "Ya tienes la última versión; no cambié nada."
    return 0
  fi
  # Se muestra lo que va a cambiar ANTES de traerlo: al actualizar se ejecuta el install.sh del código nuevo.
  echo ""
  echo -e "${NEGRITA}Cambios que traería ($nuevos commits desde $remota):${NC}"
  git -C "$origen" log --oneline "HEAD..$remota"
  echo ""
  git -C "$origen" diff --stat "HEAD" "$remota"
  echo ""
  aviso "Actualizar ejecuta el install.sh del código nuevo. Revísalo antes si no confías en el remoto: git -C \"$origen\" diff HEAD $remota -- install.sh install.ps1 bin/devskills"
  if [[ "$si" != true ]]; then
    if [[ -t 0 ]]; then
      local respuesta
      read -r -p "¿Aplicar estos cambios y reinstalar? (s/N): " respuesta
      if [[ "$respuesta" != "s" && "$respuesta" != "S" ]]; then
        echo "Cancelado; no cambié nada."
        return 0
      fi
    else
      error "Sin terminal no se aplica nada. Revisa los cambios y repite con --si: devskills update --si"
      return 1
    fi
  fi
  if ! git -C "$origen" merge --ff-only --quiet "$remota"; then
    error "No se pudo avanzar el clon sin conflictos (¿cambios locales?). Resuélvelo a mano en $origen."
    return 1
  fi
  bash "$origen/install.sh" --si
}

# Valor de un marcador de plantilla leído de documentacion/CONTEXTO.md del proyecto (vacío si no se puede).
valor_de_marcador() {
  local contexto="$1" marcador="$2" valor=""
  # shellcheck disable=SC2016  # los acentos graves de las expresiones de sed son literales de Markdown
  case "$marcador" in
    NOMBRE_PROYECTO) valor="$(sed -n '1s/^# Contexto del proyecto: *//p' "$contexto" | tr -d '\r')" ;;
    SLUG | SLUG_GUION_BAJO)
      valor="$(sed -n 's/^| Slug (carpetas, Docker, engram) | `\(.*\)` |.*$/\1/p' "$contexto" | head -n 1 | tr -d '\r')"
      [[ "$marcador" == "SLUG_GUION_BAJO" ]] && valor="${valor//-/_}"
      ;;
    PUERTO_BASE) valor="$(sed -n 's/^| Rango de puertos del host | `\([0-9][0-9]*\)` a.*$/\1/p' "$contexto" | head -n 1 | tr -d '\r')" ;;
  esac
  echo "$valor"
}

# Escribe en $3 la plantilla $1 con los marcadores {{...}} sustituidos con los datos del proyecto ($2 = CONTEXTO.md).
# Si algún marcador no se puede resolver, imprime cuál y devuelve 1.
resolver_plantilla() {
  local origen="$1" contexto="$2" salida="$3" texto marcador nombre valor
  shopt -u patsub_replacement 2>/dev/null || true # bash 5.2: "&" en el reemplazo no debe expandirse
  texto="$(cat "$origen"; printf x)"
  texto="${texto%x}"
  while IFS= read -r marcador; do
    [[ -z "$marcador" ]] && continue
    nombre="${marcador#'{{'}"
    nombre="${nombre%'}}'}"
    valor="$(valor_de_marcador "$contexto" "$nombre")"
    if [[ -z "$valor" ]]; then
      echo "$marcador"
      return 1
    fi
    texto="${texto//"$marcador"/$valor}"
  done < <(grep -oE '\{\{[A-Z_]+\}\}' "$origen" | sort -u || true)
  printf '%s' "$texto" >"$salida"
}

cmd_sync_scripts() {
  local si=false ruta=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --si|-y) si=true; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) if [[ -z "$ruta" ]]; then ruta="$1"; shift; else error "Argumento de más: $1"; return 2; fi ;;
    esac
  done
  [[ -z "$ruta" ]] && ruta="."
  local analisis="$ruta/documentacion/analisis" contexto="$ruta/documentacion/CONTEXTO.md"
  if [[ ! -f "$contexto" || ! -d "$analisis" ]]; then
    error "$ruta no es un proyecto DevSkills (falta documentacion/CONTEXTO.md o documentacion/analisis/). No cambié nada."
    return 1
  fi
  local origen="$DEVSKILLS_HOME/plantillas/analisis"
  if [[ ! -d "$origen" ]]; then
    error "No encuentro las plantillas en $origen; reinstala DevSkills."
    return 1
  fi

  local tmp
  tmp="$(mktemp -d)"
  local nuevos="" cambiados="" omitidos="" archivo nombre sin_resolver
  for archivo in "$origen"/*.py; do
    [[ -f "$archivo" ]] || continue
    nombre="$(basename "$archivo")"
    if grep -qE '\{\{[A-Z_]+\}\}' "$archivo"; then
      if ! sin_resolver="$(resolver_plantilla "$archivo" "$contexto" "$tmp/$nombre")"; then
        omitidos="${omitidos}${nombre} (marcador ${sin_resolver} que no se puede resolver desde CONTEXTO.md)"$'\n'
        continue
      fi
    else
      cp "$archivo" "$tmp/$nombre"
    fi
    if [[ ! -f "$analisis/$nombre" ]]; then
      nuevos="${nuevos}${nombre}"$'\n'
    elif ! cmp -s "$tmp/$nombre" "$analisis/$nombre"; then
      cambiados="${cambiados}${nombre}"$'\n'
    fi
  done

  local html="plan_sprints_plantilla.html"
  if [[ -f "$analisis/$html" ]] && ! cmp -s "$origen/$html" "$analisis/$html"; then
    aviso "La plantilla HTML del tablero ($html) difiere de la de DevSkills: no la toco (puede ser una personalización tuya). Compárala y decide:"
    echo "  git diff --no-index \"$analisis/$html\" \"$origen/$html\""
  elif [[ ! -f "$analisis/$html" ]]; then
    aviso "El proyecto no tiene $html; cópiala a mano de $origen si quieres el tablero."
  fi
  if [[ -n "$omitidos" ]]; then
    aviso "Scripts omitidos (compáralos a mano):"
    printf '  %s' "$omitidos"
  fi

  if [[ -z "$nuevos$cambiados" ]]; then
    ok "Los scripts de documentacion/analisis ya están al día; no cambié nada."
    rm -rf "$tmp"
    return 0
  fi

  echo -e "${NEGRITA}Scripts de documentacion/analisis que cambiarían:${NC}"
  while IFS= read -r nombre; do
    [[ -z "$nombre" ]] && continue
    echo "  nuevo     $nombre"
  done <<<"$nuevos"
  while IFS= read -r nombre; do
    [[ -z "$nombre" ]] && continue
    echo "  cambiado  $nombre"
  done <<<"$cambiados"
  echo ""
  while IFS= read -r nombre; do
    [[ -z "$nombre" ]] && continue
    git diff --no-index --stat -- "$analisis/$nombre" "$tmp/$nombre" || true
  done <<<"$cambiados"
  echo ""
  aviso "Solo se copian estos scripts: no se toca codigo/, ni documentacion/*.md, ni los JSON de datos."

  if [[ "$si" != true ]]; then
    if [[ -t 0 ]]; then
      local respuesta
      read -r -p "¿Copiar estos scripts al proyecto? (s/N): " respuesta
      if [[ "$respuesta" != "s" && "$respuesta" != "S" ]]; then
        echo "Cancelado; no cambié nada."
        rm -rf "$tmp"
        return 0
      fi
    else
      error "Sin terminal no se copia nada. Revisa los cambios y repite con --si: devskills sync-scripts --si"
      rm -rf "$tmp"
      return 1
    fi
  fi
  while IFS= read -r nombre; do
    [[ -z "$nombre" ]] && continue
    cp "$tmp/$nombre" "$analisis/$nombre"
    ok "Copiado $nombre"
  done <<<"$nuevos$cambiados"
  rm -rf "$tmp"
  echo "Revisa el resultado con 'git diff' y haz el commit tú o pídeselo al orquestador."
}

# ----------------------------------------------------------------------------
# Enrutamiento de modelo y esfuerzo (docs/enrutamiento.md)
# El archivo es LOCAL (.devskills/ está en el .gitignore del proyecto). Lo lee el orquestador al lanzar cada
# subagente con la herramienta Agent; sin archivo o con "activo": false, cada agente usa su frontmatter.
# ----------------------------------------------------------------------------

archivo_enrutamiento() { echo "$1/.devskills/enrutamiento.json"; }

fecha_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# 0 si el archivo dice "activo": true (con cualquier espaciado o saltos de línea).
enrutamiento_activo() {
  tr -d '\r\n' <"$1" | grep -qE '"activo"[[:space:]]*:[[:space:]]*true'
}

# 0 si el archivo trae la clave "activo" con un booleano (si no, se trata como inactivo).
enrutamiento_legible() {
  tr -d '\r\n' <"$1" | grep -qE '"activo"[[:space:]]*:[[:space:]]*(true|false)'
}

escribir_enrutamiento_por_omision() {
  local archivo="$1"
  mkdir -p "$(dirname "$archivo")"
  cat >"$archivo" <<EOF
{
  "activo": true,
  "version": 1,
  "tabla": {
    "desarrollo": {"modelo": "sonnet", "esfuerzo": "medium"},
    "desarrollo-excepcion": {"modelo": "sonnet", "esfuerzo": "high"},
    "angel-fixer-revision": {"modelo": "sonnet", "esfuerzo": "medium"},
    "angel-fixer-excepcion": {"modelo": "opus", "esfuerzo": "high"},
    "qa-excepcion": {"modelo": "opus", "esfuerzo": "high"},
    "qa-cierre-sprint": {"modelo": "opus", "esfuerzo": "high"},
    "verificador-ligero": {"modelo": "sonnet", "esfuerzo": "medium"},
    "verificador-final": {"modelo": "sonnet", "esfuerzo": "high"},
    "analista-arquitecto": {"modelo": "opus", "esfuerzo": "medium"},
    "pasada-documental": {"modelo": "haiku", "esfuerzo": "low"},
    "registrar-avance": {"modelo": "haiku", "esfuerzo": "low"},
    "mecanico": {"modelo": "haiku", "esfuerzo": "low"}
  },
  "escalamiento": {"max_reintentos": 1, "orden": ["esfuerzo", "modelo"]},
  "actualizado": "$(fecha_iso)"
}
EOF
}

# Cambia "activo" y "actualizado" sin tocar la tabla (archivo temporal y mv: sed -i difiere entre GNU y BSD).
cambiar_activo() {
  local archivo="$1" valor="$2" tmp
  tmp="$(mktemp)"
  sed -E -e "s/(\"activo\"[[:space:]]*:[[:space:]]*)(true|false)/\1${valor}/" \
    -e "s/(\"actualizado\"[[:space:]]*:[[:space:]]*)\"[^\"]*\"/\1\"$(fecha_iso)\"/" "$archivo" >"$tmp"
  cat "$tmp" >"$archivo"
  rm -f "$tmp"
}

# Avisa si .devskills/ no está ignorado por git (el archivo es local y nunca entra a un commit).
revisar_ignorado() {
  local ruta="$1"
  if git -C "$ruta" rev-parse --git-dir >/dev/null 2>&1 \
    && ! git -C "$ruta" check-ignore -q .devskills/enrutamiento.json 2>/dev/null; then
    aviso "git no ignora .devskills/ en este proyecto: agrega la línea '.devskills/' a su .gitignore (el archivo es local)."
  fi
}

estado_enrutamiento() {
  local ruta="$1" archivo
  archivo="$(archivo_enrutamiento "$ruta")"
  if [[ ! -f "$archivo" ]]; then
    ok "Enrutamiento de modelos: inactivo (no hay .devskills/enrutamiento.json); cada agente usa el modelo de su frontmatter. Para activarlo: 'devskills enrutamiento evaluar' y luego 'devskills enrutamiento activar'."
    return 0
  fi
  if ! enrutamiento_legible "$archivo"; then
    aviso "Enrutamiento de modelos: .devskills/enrutamiento.json no tiene \"activo\": true|false; se trata como inactivo. Reescríbelo con 'devskills enrutamiento activar --forzar'."
    return 0
  fi
  if enrutamiento_activo "$archivo"; then
    ok "Enrutamiento de modelos: activo (.devskills/enrutamiento.json). El orquestador pasa model y effort a cada subagente según esta tabla:"
    sed -nE 's/^[[:space:]]*"([^"]+)"[[:space:]]*:[[:space:]]*\{[[:space:]]*"modelo"[[:space:]]*:[[:space:]]*"([^"]+)"[[:space:]]*,[[:space:]]*"esfuerzo"[[:space:]]*:[[:space:]]*"([^"]+)".*/    \1: \2 \/ \3/p' "$archivo"
  else
    ok "Enrutamiento de modelos: desactivado (.devskills/enrutamiento.json con \"activo\": false); cada agente usa el modelo de su frontmatter."
  fi
}

# Primer archivo de prueba que encuentre (sin entrar a .git, entornos ni dependencias).
primer_archivo_de_prueba() {
  find "$1" \( -name .git -o -name node_modules -o -name .venv -o -name venv -o -name graphify-out \) -prune -o \
    -type f \( -name 'test_*.py' -o -name '*_test.py' -o -name '*.feature' -o -name '*_spec.sh' \
    -o -name '*.test.js' -o -name '*.test.ts' -o -name '*.spec.js' -o -name '*.spec.ts' -o -name '*_test.go' \) \
    -print 2>/dev/null | head -n 1 || true
}

# Comando de pruebas deducido de la configuración (vacío si no se reconoce).
comando_de_pruebas() {
  local ruta="$1" dir
  for dir in "codigo" "."; do
    if [[ -f "$ruta/$dir/pytest.ini" ]] || grep -qs '^\[tool\.pytest' "$ruta/$dir/pyproject.toml" \
      || grep -qs '^\[tool:pytest\]' "$ruta/$dir/setup.cfg"; then
      if [[ "$dir" == "." ]]; then echo "pytest"; else echo "cd $dir && pytest"; fi
      return 0
    fi
  done
  if grep -qs '"test"[[:space:]]*:' "$ruta/package.json"; then echo "npm test"; return 0; fi
  if [[ -f "$ruta/.shellspec" ]]; then echo "shellspec"; return 0; fi
  if grep -qsE '^test:' "$ruta/Makefile"; then echo "make test"; return 0; fi
  if [[ -f "$ruta/go.mod" ]]; then echo "go test ./..."; return 0; fi
  return 1
}

# Verificaciones de tipos y lint que el proyecto configura (lista separada por comas; vacío si ninguna).
verificaciones_estaticas() {
  local ruta="$1" dir lista=()
  for dir in "codigo" "."; do
    { grep -qs '^\[tool\.mypy' "$ruta/$dir/pyproject.toml" || [[ -f "$ruta/$dir/mypy.ini" ]]; } && lista+=("mypy ($dir)")
    { grep -qs '^\[tool\.ruff' "$ruta/$dir/pyproject.toml" || [[ -f "$ruta/$dir/ruff.toml" || -f "$ruta/$dir/.ruff.toml" ]]; } && lista+=("ruff ($dir)")
    [[ -f "$ruta/$dir/.importlinter" ]] && lista+=("import-linter ($dir)")
  done
  [[ -f "$ruta/tsconfig.json" ]] && lista+=("TypeScript")
  compgen -G "$ruta/eslint.config.*" >/dev/null || compgen -G "$ruta/.eslintrc*" >/dev/null && lista+=("ESLint")
  grep -qsl 'shellcheck' "$ruta"/.github/workflows/*.yml "$ruta"/.github/workflows/*.yaml && lista+=("ShellCheck (CI)")
  local IFS=","
  echo "${lista[*]+"${lista[*]}"}" # bash 3.2 (macOS) con set -u falla con un arreglo vacío sin el +
}

hay_ci() {
  compgen -G "$1/.github/workflows/*.yml" >/dev/null || compgen -G "$1/.github/workflows/*.yaml" >/dev/null \
    || [[ -f "$1/.gitlab-ci.yml" ]]
}

hay_gherkin() {
  grep -qsE '^[[:space:]]*(Escenario|Scenario)( [Pp]rincipal| Outline| [Ee]squema)?:' "$1/documentacion/SRS.md"
}

evaluar_enrutamiento() {
  local ruta="$1" prueba comando estaticas faltan=0
  echo -e "${CIAN}${NEGRITA}¿Encaja el enrutamiento de modelos en este proyecto?${NC} ($ruta)"
  echo "La cascada solo es segura si el código verifica el trabajo del modelo menor (Model Routing Playbook, regla 4)."
  prueba="$(primer_archivo_de_prueba "$ruta")"
  if [[ -z "$prueba" ]]; then
    aviso "Pruebas automatizadas: no encontré archivos de prueba (test_*.py, *.feature, *_spec.sh, *.test.ts...)."
    echo ""
    echo "Veredicto: no recomendado"
    echo "Motivo: sin pruebas no hay cascada segura; nada detecta que un modelo menor falló y no hay cuándo escalar."
    return 0
  fi
  ok "Pruebas automatizadas (por ejemplo ${prueba#"$ruta"/})"
  if comando="$(comando_de_pruebas "$ruta")"; then
    ok "Comando de pruebas: $comando"
  else
    aviso "Comando de pruebas: no lo deduje de la configuración (pytest, package.json, .shellspec, Makefile, go.mod); escríbelo en CONTEXTO.md."
    faltan=$((faltan + 1))
  fi
  if hay_ci "$ruta"; then
    ok "CI configurado"
  else
    aviso "CI: no hay workflow; la verificación queda solo en local."
    faltan=$((faltan + 1))
  fi
  estaticas="$(verificaciones_estaticas "$ruta")"
  if [[ -n "$estaticas" ]]; then
    ok "Tipos y lint: ${estaticas//,/, }"
  else
    aviso "Tipos y lint: no encontré configuración (mypy, ruff, import-linter, TypeScript, ESLint, ShellCheck)."
    faltan=$((faltan + 1))
  fi
  if hay_gherkin "$ruta"; then
    ok "SRS con escenarios Gherkin (criterios de aceptación verificables)"
  else
    aviso "SRS con Gherkin: documentacion/SRS.md no tiene escenarios; el criterio de \"falló\" depende solo de las pruebas."
    faltan=$((faltan + 1))
  fi
  echo ""
  if [[ $faltan -eq 0 ]]; then
    echo "Veredicto: recomendado"
    echo "Motivo: pruebas con su comando, CI, tipos y lint y Gherkin detectan el fallo de un modelo menor; escalar es seguro."
  else
    echo "Veredicto: parcial"
    echo "Motivo: hay pruebas, pero faltan $faltan de las verificaciones de arriba; actívalo solo si aceptas que algunos fallos se detecten tarde (QA de cierre)."
  fi
}

cmd_enrutamiento() {
  local accion="" ruta="" forzar=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      estado|activar|desactivar|evaluar)
        if [[ -z "$accion" ]]; then accion="$1"; shift; else error "Acción de más: $1"; return 2; fi ;;
      --forzar) forzar=true; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) if [[ -z "$ruta" ]]; then ruta="$1"; shift; else error "Argumento de más: $1"; return 2; fi ;;
    esac
  done
  [[ -z "$accion" ]] && accion="estado"
  [[ -z "$ruta" ]] && ruta="."
  if [[ ! -d "$ruta" ]]; then
    error "No existe la carpeta $ruta."
    return 1
  fi
  if [[ "$forzar" == true && "$accion" != "activar" ]]; then
    error "--forzar solo aplica a 'activar'."
    return 2
  fi
  local archivo
  archivo="$(archivo_enrutamiento "$ruta")"
  case "$accion" in
    estado) estado_enrutamiento "$ruta" ;;
    evaluar) evaluar_enrutamiento "$ruta" ;;
    activar)
      if [[ ! -f "$ruta/documentacion/CONTEXTO.md" ]]; then
        error "$ruta no es un proyecto DevSkills (falta documentacion/CONTEXTO.md). No cambié nada."
        return 1
      fi
      if [[ -f "$archivo" && "$forzar" != true ]]; then
        if enrutamiento_legible "$archivo"; then
          cambiar_activo "$archivo" true
          ok "Reactivé .devskills/enrutamiento.json sin tocar su tabla (para volver a la tabla por omisión: --forzar)."
        else
          error ".devskills/enrutamiento.json existe pero no tiene \"activo\": true|false. Revísalo o reescríbelo con --forzar. No cambié nada."
          return 1
        fi
      else
        escribir_enrutamiento_por_omision "$archivo"
        ok "Creé .devskills/enrutamiento.json con la tabla por omisión."
      fi
      revisar_ignorado "$ruta"
      estado_enrutamiento "$ruta"
      ;;
    desactivar)
      if [[ ! -f "$archivo" ]]; then
        ok "No hay .devskills/enrutamiento.json: el enrutamiento ya está inactivo. No cambié nada."
        return 0
      fi
      if ! enrutamiento_legible "$archivo"; then
        error ".devskills/enrutamiento.json no tiene \"activo\": true|false; ya se trata como inactivo. No cambié nada."
        return 1
      fi
      cambiar_activo "$archivo" false
      ok "Desactivé el enrutamiento; la tabla se conserva para cuando lo reactives."
      ;;
  esac
}

# ----------------------------------------------------------------------------
# Motor gráfico (docs/motor.md): panel de control local, lanzador de servicios y orquestador OPCIONAL.
# El código vive en $DEVSKILLS_HOME/motor; el ESTADO vive fuera del repositorio, en DEVSKILLS_DATOS o ~/.devskills.
# (DEVSKILLS_HOME es la carpeta de la carga útil; por eso los datos usan otra variable.)
# ----------------------------------------------------------------------------

datos_motor() {
  local d="${DEVSKILLS_DATOS:-$HOME/.devskills}"
  if command -v cygpath >/dev/null 2>&1; then d="$(cygpath -m "$d")"; fi
  echo "$d"
}

# Ruta nativa para pasársela a Python (en Windows, formato C:/...).
ruta_nativa() {
  if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else echo "$1"; fi
}

# Deja en PY el Python 3.12 y exporta DEVSKILLS_DATOS en formato nativo; devuelve 1 si falta Python o el motor.
preparar_motor() {
  if ! PY="$(buscar_python)"; then
    error "Hace falta Python 3.12. Corre 'devskills doctor' para ver cómo instalarlo."
    return 1
  fi
  MOTOR="$DEVSKILLS_HOME/motor"
  if [[ ! -d "$MOTOR" ]]; then
    error "No encuentro $MOTOR; reinstala DevSkills."
    return 1
  fi
  DEVSKILLS_DATOS="$(datos_motor)"
  export DEVSKILLS_DATOS
}

puerto_valido() { [[ "$1" =~ ^[0-9]+$ ]] && (( $1 >= 1024 && $1 <= 65535 )); }

cmd_panel() {
  local accion="" puerto="" no_abrir=false simular=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      iniciar|apagar|estado)
        if [[ -z "$accion" ]]; then accion="$1"; shift; else error "Acción de más: $1"; return 2; fi ;;
      --puerto)
        puerto="${2:-}"
        if ! puerto_valido "$puerto"; then error "--puerto necesita un número entre 1024 y 65535."; return 2; fi
        shift 2 ;;
      --no-abrir) no_abrir=true; shift ;;
      --simular) simular=true; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) error "Argumento de más: $1"; return 2 ;;
    esac
  done
  [[ -z "$accion" ]] && accion="iniciar"
  preparar_motor || return 1
  local args=("$accion")
  [[ -n "$puerto" ]] && args+=(--puerto "$puerto")
  [[ "$no_abrir" == true ]] && args+=(--no-abrir)
  [[ "$simular" == true ]] && args+=(--simular)
  if [[ "$accion" == "iniciar" && ! -f "$DEVSKILLS_DATOS/proyectos.json" ]]; then
    aviso "No hay registro de proyectos en $DEVSKILLS_DATOS. Créalo con 'devskills motor iniciar' (o migra uno previo con 'devskills motor migrar --desde <carpeta>')."
  fi
  "$PY" "$(ruta_nativa "$MOTOR/panel/panel.py")" "${args[@]}"
  if [[ "$accion" == "estado" ]]; then
    echo "Datos: $DEVSKILLS_DATOS"
    echo "Status line de límites (opcional): python $(ruta_nativa "$MOTOR/panel/statusline_limites.py") (ver docs/motor.md)"
  fi
}

cmd_servicios() {
  local accion="" objetivo="" simular=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      levantar|apagar|detener|listar)
        if [[ -z "$accion" ]]; then accion="$1"; shift; else error "Acción de más: $1"; return 2; fi ;;
      --simular) simular=true; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) if [[ -z "$objetivo" ]]; then objetivo="$1"; shift; else error "Argumento de más: $1"; return 2; fi ;;
    esac
  done
  if [[ -z "$accion" ]]; then
    error "Falta la acción. Uso: devskills servicios <levantar|apagar|listar> [objetivo] [--simular]"
    return 2
  fi
  if [[ "$accion" != "listar" && -z "$objetivo" ]]; then
    error "Falta el objetivo (id de proyecto o de servicio). Míralos con 'devskills servicios listar'."
    return 2
  fi
  preparar_motor || return 1
  local args=("$accion")
  [[ -n "$objetivo" ]] && args+=("$objetivo")
  [[ "$simular" == true ]] && args+=(--simular)
  "$PY" "$(ruta_nativa "$MOTOR/servicios/servicios.py")" "${args[@]}"
}

# Python del venv del orquestador (falla si no existe).
python_orquestador() {
  local venv="$1/orquestador/.venv" p
  for p in "$venv/Scripts/python.exe" "$venv/bin/python"; do
    if [[ -x "$p" ]]; then echo "$p"; return 0; fi
  done
  return 1
}

cmd_orquestador() {
  local accion=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      instalar|iniciar|apagar|estado)
        if [[ -z "$accion" ]]; then accion="$1"; shift; else error "Acción de más: $1"; return 2; fi ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) error "Argumento de más: $1"; return 2 ;;
    esac
  done
  [[ -z "$accion" ]] && accion="estado"
  preparar_motor || return 1
  local venv_py
  if [[ "$accion" == "instalar" ]]; then
    echo "El orquestador es OPCIONAL: el panel y los servicios funcionan sin él. Crea un venv en $DEVSKILLS_DATOS/orquestador/.venv e instala claude-agent-sdk (versión fijada)."
    mkdir -p "$DEVSKILLS_DATOS/orquestador"
    local venv="$DEVSKILLS_DATOS/orquestador/.venv"
    if ! venv_py="$(python_orquestador "$DEVSKILLS_DATOS")"; then
      "$PY" -m venv "$venv" || { error "No pude crear el venv."; return 1; }
      venv_py="$(python_orquestador "$DEVSKILLS_DATOS")" || { error "El venv quedó sin intérprete."; return 1; }
    fi
    "$venv_py" -m pip install -r "$(ruta_nativa "$MOTOR/orquestador/requirements.txt")" || { error "Falló pip install."; return 1; }
    ok "Orquestador instalado. Arráncalo con 'devskills orquestador iniciar'."
    return 0
  fi
  if ! venv_py="$(python_orquestador "$DEVSKILLS_DATOS")"; then
    if [[ "$accion" == "estado" ]]; then
      echo "no instalado (es opcional; para usarlo: devskills orquestador instalar)"
      return 0
    fi
    aviso "El orquestador es opcional y no está instalado. Instálalo con: devskills orquestador instalar"
    return 1
  fi
  "$venv_py" "$(ruta_nativa "$MOTOR/orquestador/orquestador.py")" "$accion"
}

cmd_motor() {
  local accion="" desde="" forzar=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      migrar|iniciar)
        if [[ -z "$accion" ]]; then accion="$1"; shift; else error "Acción de más: $1"; return 2; fi ;;
      --desde)
        desde="${2:-}"
        if [[ -z "$desde" ]]; then error "--desde necesita una carpeta."; return 2; fi
        shift 2 ;;
      --forzar) forzar=true; shift ;;
      -h|--help) mostrar_ayuda; return 0 ;;
      -*) error "Opción desconocida: $1"; return 2 ;;
      *) error "Argumento de más: $1"; return 2 ;;
    esac
  done
  if [[ -z "$accion" ]]; then
    error "Falta la acción. Uso: devskills motor <iniciar|migrar --desde <carpeta> [--forzar]>"
    return 2
  fi
  if [[ "$forzar" == true && "$accion" != "migrar" ]]; then error "--forzar solo aplica a 'migrar'."; return 2; fi
  if [[ -n "$desde" && "$accion" != "migrar" ]]; then error "--desde solo aplica a 'migrar'."; return 2; fi
  preparar_motor || return 1
  case "$accion" in
    migrar)
      if [[ -z "$desde" ]]; then error "Falta --desde <carpeta> (la instalación previa)."; return 2; fi
      local args=(--desde "$(ruta_nativa "$desde")" --destino "$DEVSKILLS_DATOS")
      [[ "$forzar" == true ]] && args+=(--forzar)
      "$PY" "$(ruta_nativa "$MOTOR/comun/migrar.py")" "${args[@]}"
      ;;
    iniciar)
      mkdir -p "$DEVSKILLS_DATOS"
      if [[ -f "$DEVSKILLS_DATOS/proyectos.json" ]]; then
        ok "Ya hay un registro de proyectos en $DEVSKILLS_DATOS/proyectos.json; no lo toqué."
      else
        cp "$MOTOR/plantillas/proyectos.ejemplo.json" "$DEVSKILLS_DATOS/proyectos.json"
        ok "Creé $DEVSKILLS_DATOS/proyectos.json desde la plantilla (un proyecto de ejemplo)."
      fi
      echo "Siguiente paso: la detección automática de tus proyectos está en el panel (vista Registro, 'Detectar')."
      if [[ -t 0 ]]; then
        local respuesta
        read -r -p "¿Abrir el panel ahora? (s/N): " respuesta
        if [[ "$respuesta" == "s" || "$respuesta" == "S" ]]; then
          "$PY" "$(ruta_nativa "$MOTOR/panel/panel.py")" iniciar
        fi
      else
        echo "Ábrelo con: devskills panel"
      fi
      ;;
  esac
}

main() {
  local comando="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$comando" in
    init) cmd_init "$@" ;;
    doctor) cmd_doctor "$@" ;;
    version|--version|-v) echo "devskills $VERSION" ;;
    update) cmd_update "$@" ;;
    sync-scripts) cmd_sync_scripts "$@" ;;
    enrutamiento) cmd_enrutamiento "$@" ;;
    panel) cmd_panel "$@" ;;
    servicios) cmd_servicios "$@" ;;
    orquestador) cmd_orquestador "$@" ;;
    motor) cmd_motor "$@" ;;
    help|--help|-h) mostrar_ayuda ;;
    *) error "Comando desconocido: $comando"; mostrar_ayuda; return 2 ;;
  esac
}

main "$@"
